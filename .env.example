# Скопируйте этот файл в .env и задайте свой пароль для MinIO.
# Файл .env не коммитится (см. .gitignore).
MINIO_ROOT_PASSWORD=change-me

# Параметры подключения к PostgreSQL (ЛР2)
DB_HOST=localhost
DB_NAME=flight_service_db
DB_PORT=5432
DB_USER=postgres
DB_PASS=change-me

# MinIO (ЛР3): загрузка файлов услуг
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=flight-media
MINIO_PUBLIC_URL=http://localhost:9100/flight-media
